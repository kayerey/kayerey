
import tkinter as tk

from tkinter import messagebox
import openpyxl
from openpyxl.styles import Font
import os



FILE_NAME = "record.xlsx"
PASS_MARK = 60


def workB():
    if os.path.exists(FILE_NAME):
        wb = openpyxl.load_workbook(FILE_NAME)
        ws = wb.active
    else:
        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = "Scores"
        ws.append(["Name", "Score", "Status"])
        for col in range(1, 4):
            ws.cell(row=1, column=col).font = Font(bold=True)
    return wb, ws

def add_student_record(name, score):
    wb, ws = workB()
    status = "Pass" if score >= PASS_MARK else "Fail"
    ws.append([name, score, status])
    save_average_score(ws)
    wb.save(FILE_NAME)


def save_average_score(ws):
    last_row = ws.max_row
    if ws.cell(row=last_row, column=1).value == "Average":
        ws.delete_rows(last_row)
    scores = [cell.value for cell in ws["B"][1:] if isinstance(cell.value, (int, float))]
    if scores:
        avg = sum(scores) / len(scores)
        ws.append(["Average", avg, ""])

def on_save():
    name = name_entry.get()
    try:
        score = float(score_entry.get())
        if not name:
            raise ValueError("Name is empty")
        add_student_record(name, score)
        messagebox.showinfo("Success", f"Record saved for {name}")
        name_entry.delete(0, tk.END)
        score_entry.delete(0,tk.END)
    except ValueError as e:
        messagebox.showerror("Error", "Please enter a valid name and numeric score.")

def on_display():
    wb, ws = workB()
    records_window = tk.Toplevel(main)
    records_window.title("Student Records")
    for i, row in enumerate(ws.iter_rows(min_row=2, values_only=True)):
        text = f"{row[0]} - {row[1]} - {row[2]}" if row[0] != "Average" else f"\nAverage Score: {row[1]}"
        tk.Label(records_window, text=text).grid(row=i, column=0, sticky="w")


main = tk.Tk()
main.title("Student Score Tracker")

tk.Label(main, text="Student Name:").grid(row=0, column=0, padx=10, pady=5)
name_entry = tk.Entry(main)
name_entry.grid(row=0, column=1, padx=10)

tk.Label(main, text="Score:").grid(row=2, column=0, padx=10, pady=5)
score_entry = tk.Entry(main)
score_entry.grid(row=2, column=1, padx=10)

tk.Button(main, text="Save ", command=on_save).grid(row=3, column=0, pady=10)
tk.Button(main, text="Display Records", command=on_display).grid(row=4, column=0, pady=5)

main.mainloop()
